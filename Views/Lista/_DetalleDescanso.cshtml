@model dynamic

<div>
    <p><strong>Nombre Completo:</strong> @Model.NombreCompleto</p>
    <p><strong>DNI:</strong> @Model.Dni</p>
    <p><strong>Tipo de Licencia:</strong> @Model.TipoLicencia</p>
    <p><strong>Fecha de Registro:</strong> @Model.FechaRegistro.ToString("dd/MM/yyyy")</p>
    <p><strong>Estado:</strong> @Model.Estado</p>
    <hr />
    <p><strong>Información Adicional:</strong></p>
    <p>@Model.Observacion</p>
</div>