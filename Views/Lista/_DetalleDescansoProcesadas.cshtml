@model proyectoIngSoft.Models.Descanso

<div class="modal-header">
    <h5 class="modal-title"><i class="bi bi-file-medical"></i> Detalles del Descanso Médico</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">

    <!-- INFORMACIÓN PERSONAL -->
<h6 class="section-header"><i class="bi bi-person-vcard"></i> Información Personal</h6>
<div class="section-box">
    <div class="row mb-2">
        <div class="col-md-6"><strong>Empleado</strong><br />@Model.User.Username @Model.User.Apellidos</div>
        <div class="col-md-6"><strong>DNI</strong><br />@Model.User.Dni</div>
    </div>
    <div class="row mb-2">
        <div class="col-md-6"><strong>Email</strong><br />@Model.Email</div>
        <div class="col-md-6"><strong>Teléfono</strong><br />@Model.Telefono</div>
    </div>
    <div class="row">
        <div class="col-md-6"><strong>Cargo</strong><br />@Model.CargoDescanso</div>
        <div class="col-md-6"><strong>Área</strong><br />@Model.AreaDescanso</div>
    </div>
</div>


    <!-- INFORMACIÓN DEL DESCANSO -->
    <h6 class="section-header"><i class="bi bi-calendar-event"></i> Información del Descanso</h6>
    <div class="section-box">
        <div class="row mb-2">
            <div class="col-md-6"><strong>Tipo de Descanso</strong><br />@Model.TipoDescanso.Nombre</div>
            <div class="col-md-6"><strong>Razón del Descanso</strong><br />
                @if (Model.Accidente != null)
                {
                    @Model.Accidente.Observaciones
                }
                else if (Model.Maternidad != null)
                {
                    @Model.Maternidad.Descripcion
                }
                else if (Model.Enfermedad != null)
                {
                    @Model.Enfermedad.DescEnfe
                }
                else
                {
                    @("N/A")
                }
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4"><strong>Fecha Registro</strong><br />@Model.FechaSolicitud.ToString("dd/MM/yyyy")</div>
            <div class="col-md-4"><strong>Fecha Inicio</strong><br />@Model.FechaIni.ToString("dd/MM/yyyy")</div>
            <div class="col-md-4"><strong>Fecha Fin</strong><br />@Model.FechaFin.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="row">
            <div class="col-md-6"><strong>Días Totales</strong><br />@Model.DiasTotales días</div>
            <div class="col-md-6"><strong>Días Transcurridos</strong><br />@Model.DiasTranscurridos días</div>
        </div>
    </div>

    <!-- INFORMACIÓN MÉDICA -->
    <h6 class="section-header"><i class="bi bi-hospital"></i> Información Médica</h6>
    <div class="section-box">
        <div class="row mb-2">
            <div><strong>Diagnóstico</strong></div>
            <div class="diagnosis-box">@Model.DiagnosticoDescanso</div>
        </div>
        <div class="row mb-2">
            <div class="col-md-6"><strong>Centro Médico</strong><br />@Model.CentroMedicoDescanso</div>
            <div class="col-md-6"><strong>Código ESSALUD</strong><br />@Model.CodigoEssalud</div>
        </div>
        <div class="row">
            <div class="col-md-6"><strong>Médico Tratante</strong><br />@Model.MedicoTratanteDescanso</div>
            <div class="col-md-6"><strong>CMP</strong><br />@Model.CMPDescanso</div>
        </div>
    </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>
