@model proyectoIngSoft.Models.Notification

<div class="p-3">
    <h4>@Model.Titulo</h4>
    <span class="badge @(Model.Estado=="Aprobada" ? "bg-success" : Model.Estado=="Rechazada" ? "bg-danger" : "bg-warning text-dark")">
        @Model.Estado
    </span>

    <p class="mt-3">@Model.Detalle</p>

    <hr />
    <h6>Notas adicionales</h6>
    <p>@Model.Mensaje</p>

    @if (Model.DocumentoAdjuntos.Any())
    {
        <h6>Documentos adjuntos</h6>
        <ul class="list-group">
            @foreach (var doc in Model.DocumentoAdjuntos)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @doc
                    <div>
                        <a class="btn btn-sm btn-primary">Ver</a>
                        <a class="btn btn-sm btn-secondary">Descargar</a>
                    </div>
                </li>
            }
        </ul>
    }
</div>
